# Base URL of the standalone backend API deployed on Google Cloud Run
# Leave empty in local development to default to http://localhost:8080
NEXT_PUBLIC_API_URL=

# Optional base path when hosting on GitHub Pages under a repository subpath (e.g. /familia-cdia); leave empty when hosting at the root on a custom domain
NEXT_PUBLIC_BASE_PATH=

# Backend server configuration (backend/server.mjs)
PORT=8080
ALLOWED_ORIGIN=*
DATA_DIR=

# Optional Supabase primary database + moderation queue (backend/server.mjs)
# When configured, GET reads from Supabase with automatic fallback to DATA_DIR,
# and POST queues submissions in public.sponsorship_requests (status='pending').
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Bearer token protecting POST /api/sync-backup (also used by .github/workflows/sync-backup.yml)
SYNC_TOKEN=
# Interval in ms for background Supabase -> DATA_DIR backup sync (default: 21600000 = 6h)
BACKUP_SYNC_INTERVAL_MS=21600000
