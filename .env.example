# Base URL of the standalone backend API deployed on Google Cloud Run
# Leave empty in local development to default to http://localhost:8080
NEXT_PUBLIC_API_URL=

# Optional base path when hosting on GitHub Pages under a repository subpath (e.g. /familia-cdia); leave empty when hosting at the root on a custom domain
NEXT_PUBLIC_BASE_PATH=

# Backend server configuration (backend/server.mjs)
PORT=8080
ALLOWED_ORIGIN=*
DATA_DIR=
